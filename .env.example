# Obrigatória: senha para abrir o painel
PAINEL_SENHA=troque-por-uma-senha-forte

# Obrigatória para os alertas automáticos (a Vercel manda no header do cron)
CRON_SECRET=gere-um-valor-aleatorio-longo

# Armazenamento: preenchida automaticamente ao conectar Neon Postgres (Vercel > Storage, plano Free)
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# URL pública do painel (opcional; usada nos links dos alertas e no webhook do Twilio)
# PAINEL_URL=https://painel-assinaturas-geomatch.vercel.app

# E-mail via Resend (https://resend.com). Use um remetente FORA do domínio geomatchbr.com
RESEND_API_KEY=
ALERT_EMAIL_FROM=Alertas GeoMatch <alertas@seu-dominio-verificado.com>

# WhatsApp: callmebot (grátis, só para o seu número) ou twilio
WHATSAPP_PROVIDER=callmebot
CALLMEBOT_APIKEY=

# Se WHATSAPP_PROVIDER=twilio (permite responder PAGO)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# Valores iniciais dos canais (dá para editar no painel depois)
# ALERT_WHATSAPP_TO=5573999999999
# ALERT_EMAIL_TO=seu.email@gmail.com
