# Obrigatória: senha para abrir o painel
PAINEL_SENHA=troque-por-uma-senha-forte

# Obrigatória para os alertas automáticos (a Vercel manda no header do cron)
CRON_SECRET=gere-um-valor-aleatorio-longo

# Armazenamento: preenchida automaticamente ao conectar Neon Postgres (Vercel > Storage, plano Free)
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# URL pública do painel (opcional; usada no botão "Abrir painel" dos e-mails)
# PAINEL_URL=https://painel-assinaturas-geomatch.vercel.app

# Servidor SMTP que envia os alertas. Use uma conta FORA do domínio geomatchbr.com.
# Exemplo com Gmail (precisa de verificação em 2 etapas + "senha de app"):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sua.conta@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
# Remetente exibido (opcional; padrão: Alertas GeoMatch <SMTP_USER>)
# ALERT_EMAIL_FROM=Alertas GeoMatch <sua.conta@gmail.com>

# Destinatário inicial (opcional; padrão: Samueljim19@hotmail.com, editável no painel)
# ALERT_EMAIL_TO=Samueljim19@hotmail.com
